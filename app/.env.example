# ── Required for public deployment ────────────────────────────────────────────
# Copy this file to .env (local dev) or paste into Vercel → Settings → Env Vars
# Credentials: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Without this the app runs in DEMO MODE — payments are simulated (no charge).
#
# Test (development / staging):
#   VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...  (use card 4242 4242 4242 4242)
#
# Production (real charges):
#   VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
#
# The server also needs STRIPE_SECRET_KEY set (sk_test_... or sk_live_...)
# in the server environment (never expose secret keys to the browser).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
