# ── Required for public deployment ────────────────────────────────────────────
# Copy this file to .env (local dev) or paste into Vercel → Settings → Env Vars
# Credentials: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional (payments) ────────────────────────────────────────────────────────
# Without this the app runs in DEMO MODE — payments are simulated (no charge).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
